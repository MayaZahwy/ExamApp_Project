# Copy to `.env` at the repo root for `docker compose up`.
# Do not commit real secrets. Hosted Supabase only — no local Postgres container.

# --- Shared by auth / exams / submissions ---
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:8080

# --- Gateway (public API; Vercel points VITE_API_URL here in production) ---
SERVER_PORT=3000

# --- Client (Compose build args; on Vercel set these in the Vercel project env) ---
VITE_API_URL=http://localhost:3000
VITE_USE_MOCK_API=false
CLIENT_PORT=8080

# --- Optional local (non-Docker) upstream URLs for gateway ---
# AUTH_SERVICE_URL=http://localhost:3001
# EXAMS_SERVICE_URL=http://localhost:3002
# SUBMISSIONS_SERVICE_URL=http://localhost:3003
