# Copy to `.env` at the repo root for `docker compose up`.
# Do not commit real secrets. Hosted Supabase only — no local Postgres container.

# --- Server (Render + Compose) ---
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGIN=http://localhost:8080
SERVER_PORT=3000

# --- Client (Compose build args; on Vercel set these in the Vercel project env) ---
VITE_API_URL=http://localhost:3000
VITE_USE_MOCK_API=false
CLIENT_PORT=8080
